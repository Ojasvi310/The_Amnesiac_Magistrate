# Continual Counsel — .gitignore

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
env/
.venv/

# Model artifacts (never committed — transferred via export bundles)
*.gguf
*.safetensors
*.bin

# Export bundles and run artifacts (large, machine-generated)
exports/*/
runs/*/
!exports/.gitkeep

# SQLite databases
*.db
*.sqlite
*.sqlite3

# FAISS indexes (rebuilt locally from raw docs)
data/faiss_index/
*.faiss

# Replay cache (generated by Colab; included in export bundle, not git)
data/replay_cache/*/
!data/replay_cache/.gitkeep

# Jupyter checkpoints
.ipynb_checkpoints/
*.ipynb_checkpoints/

# Environment
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# llama.cpp clone (checked out by pipeline on Colab, not repo content)
llama.cpp/

# Logs
*.log
